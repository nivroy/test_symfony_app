<div class="card">
	<h1>Contador MVC</h1>

	<div class="value" id="counter-value">{{ count }}</div>

	<div>
		<button class="btn primary" data-action="{{ path('app_counter_increment') }}">Incrementar</button>
		<button class="btn primary" data-action="{{ path('app_counter_decrement') }}">Reducir</button>
		<button class="btn" data-action="{{ path('app_counter_reset') }}">Reset</button>
	</div>
</div>

<script>
	document.querySelectorAll('button[data-action]').forEach(btn => {
btn.addEventListener('click', async e => {
const url = btn.dataset.action;
const res = await fetch(url, {method: 'POST'});
const html = await res.text();
// extraemos el valor actualizado desde el HTML resultante
const parser = new DOMParser();
const doc = parser.parseFromString(html, 'text/html');
const newValue = doc.querySelector('#counter-value').textContent;
document.querySelector('#counter-value').textContent = newValue;
});
});
</script>
