{% extends 'base.html.twig' %}

{% block title %}Panel de empresa Â· Demo Symfony{% endblock %}

{% block body %}
  <div class="card">
    <h1>Tu API Key</h1>
    {% if companyName or ruc %}
      <p><strong>{{ companyName }}</strong>{% if ruc %} Â· RUC: {{ ruc }}{% endif %}</p>
    {% endif %}

        <div class="token-box">
      <code id="company-apikey">{{ apiKey ?: '—' }}</code>
      <div class="token-actions">
        <button id="refresh-apikey" class="icon-btn" title="Refrescar API Key" aria-label="Refrescar API Key" {{ keyId is not defined or not keyId ? 'disabled' : '' }}>Refrescar</button>
        <button id="copy-apikey" class="icon-btn" title="Copiar API Key" aria-label="Copiar API Key">Copiar</button>
      </div>
    </div>
    <div id="copy-feedback" class="hint" role="status" aria-live="polite" style="display:none;">Copiado</div>
    {% if not apiKey %}
      <div class="hint">Aún no hay una API Key disponible.</div>
    {% endif %}

    <div class="actions" style="margin-top:1rem">
      <a class="btn" href="{{ path('app_home') }}">Volver al inicio</a>
    </div>
  </div>

  <style>
    .token-box { display:flex; align-items:center; gap:.5rem; margin: .5rem 0 1rem; padding:.5rem .75rem; border:1px solid #e3e5e8; border-radius:.5rem; background: linear-gradient(180deg,#f9fbff, #f2f6ff); }
    .token-box code { font-size: 1.1rem; font-weight: 700; padding: .25rem .5rem; color:#0b5ed7; background: #ffffff; border: 1px solid #cfe2ff; border-radius: .35rem; }
    .token-actions { display:flex; align-items:center; gap:.4rem; }
    .icon-btn { display:inline-flex; align-items:center; justify-content:center; border: 1px solid #d0d4da; background: #fff; color:#0b5ed7; border-radius: .45rem; padding:.45rem .6rem; cursor:pointer; transition: background .15s ease, transform .05s ease; }
    .icon-btn:hover { background:#eef5ff; }
  </style>

  <script>
    (function(){
      var btn = document.getElementById('copy-apikey');
      var el = document.getElementById('company-apikey');
      var fb = document.getElementById('copy-feedback');
      if (!btn || !el) return;
      btn.addEventListener('click', function(){
        var text = (el.textContent || '').trim();
        if (!text) return;
        (navigator.clipboard && navigator.clipboard.writeText ? navigator.clipboard.writeText(text) : Promise.reject())
          .then(function(){ if (fb) { fb.style.display='block'; setTimeout(function(){ fb.style.display='none'; }, 1200); }})
          .catch(function(){ try { var r=document.createRange(); r.selectNode(el); var s=window.getSelection(); s.removeAllRanges(); s.addRange(r); document.execCommand('copy'); s.removeAllRanges(); if (fb) { fb.style.display='block'; setTimeout(function(){ fb.style.display='none'; }, 1200); } } catch(e){} });
      });
    })();
  </script>
  <script>
    (function(){
      var rbtn = document.getElementById('refresh-apikey');
      var el = document.getElementById('company-apikey');
      if (!rbtn || !el) return;
      rbtn.addEventListener('click', function(){
        rbtn.disabled = true; rbtn.setAttribute('aria-busy','true');
        fetch('{{ path('app_api_company_apikey_refresh') }}', { method: 'POST', credentials: 'same-origin' })
          .then(function(r){ return r.json(); })
          .then(function(data){
            if (data && data.apiKey) {
              el.textContent = String(data.apiKey);
            } else if (data && data.error) {
              if (window.showServiceError) window.showServiceError(data.error);
            }
          })
          .catch(function(){ if (window.showServiceError) window.showServiceError('No se pudo refrescar la API Key.'); })
          .finally(function(){ rbtn.disabled = false; rbtn.removeAttribute('aria-busy'); });
      });
    })();
  </script>
{% endblock %}


